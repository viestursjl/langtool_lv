    <!--    ŠEIT SĀKAS INTERPUNKCIJAS KĻŪDU ANALĪZE -->

    <category id="PUNKT" name="Interpunkcija" type="grammar">

        <rulegroup id="iespraudumi" name="Iespraudumi">
            <rule id="iespraudumi_abpusēji" name="Iespraudumi, kur abās pusēs jābūt komatiem">
                <pattern>
                    <token regexp="yes" negate="yes">[,.!?]</token>
                    <marker><token regexp="yes" spacebefore="yes" case_sensitive="yes">piemēram|savukārt|(manu|tavu|viņu)prāt</token></marker>
                    <token negate="yes">,</token>
                </pattern>
                <message>Iespraudumus tekstā atdala ar komatiem. Vēlams rakstīt: <suggestion>, \2,</suggestion></message>
                <example correction=", piemēram,">Man<marker> piemēram</marker> nav pretenziju.</example>
            </rule>
            <rule id="iespraudumi_sākumā" name="Iespraudumi, kas atrodas teikuma sākumā">
                <pattern>
                    <marker><token regexp="yes" spacebefore="yes" case_sensitive="yes">Piemēram|Savukārt|(Manu|Tavu|Viņu)prāt</token></marker>
                    <token negate="yes">,</token>
                </pattern>
                <message>Iespraudumus tekstā atdala ar komatiem. Vēlams rakstīt: <suggestion>\1,</suggestion></message>
                <example correction=", piemēram,">Man<marker> piemēram</marker> nav pretenziju.</example>
            </rule>
        </rulegroup>

        <rulegroup id="bet" name="Bet">
            <rule id="komats_bet" name="Komats pirms bet">
                <!-- Vēl komata lietojums nav noteikts gadījumos ", nu bet" vai "nu, bet" -->
                <antipattern>
                    <token>viens</token>
                    <token spacebefore="yes">bet</token>
                    <token regexp="yes">–|\.+|…</token>
                </antipattern>
                <pattern>
                    <token regexp="yes" negate="yes">\p{Punct}|bet</token>
                    <token>bet</token>
                </pattern>
                <message>Šajā teikumā pirms vārda "bet" visticamāk ir jālieto komats - "<suggestion>\1, \2</suggestion>".</message>
                <example correction=", bet">Man ir ābols<marker> bet</marker> tev nē!</example>
            </rule>
            <rule id="komats_bet_bet_nav" name="Nav komats starp bet bet ">
                <pattern>
                    <token regexp="yes">[Bb]et</token>
                    <token>,</token>
                    <token spacebefore="yes">bet</token>
                </pattern>
                <message>Šajā teikumā pirms vārda "bet" visticamāk nav jālieto komats - "<suggestion>\1 \3</suggestion>".</message>
                <example></example>
            </rule>
            <rule id="komats_viens_bet_nav" name="Nav komats starp viens bet ">
                <pattern>
                    <marker>
                        <token>viens</token>
                        <token>,</token>
                        <token spacebefore="yes">bet</token>
                    </marker>
                    <token regexp="yes">–|\.+|…</token>
                </pattern>
                <message>Šajā teikumā pirms vārda "bet" visticamāk nav jālieto komats - "<suggestion>\1 \3</suggestion>".</message>
                <example></example>
            </rule>
        </rulegroup>

        <rulegroup id="ka" name="Ka">
            <!-- Vēl komata lietojums nav noteikts gadījumos "tā ka", "(tādēļ|tāpēc) ka" -->
            <rule id="komats_ka" name="Komats pirms ka">
                <pattern>
                    <token regexp="yes" negate="yes">\p{Punct}|[Uu]n|[Vv]ai|[Bb]et|[Nn]evis|[Tt]ā(dēļ|pēc)?</token>
                    <token spacebefore="yes">ka</token>
                </pattern>
                <message>Šajā teikumā pirms vārda "ka" visticamāk ir jālieto komats - "<suggestion>\1, \2</suggestion>".</message>
                <example correction=", ka"><marker> ka</marker></example>
            </rule>
            <rule id="komats_ka_nav" name="Nav komats pirms ka">
                <pattern>
                    <token regexp="yes">[Uu]n|[Vv]ai|[Bb]et|[Nn]evis|[Tt]ā(dēļ|pēc)?</token>
                    <token>,</token>
                    <token spacebefore="yes">ka</token>
                </pattern>
                <message>Šajā teikumā pirms vārda "ka" visticamāk nav jālieto komats - "<suggestion>\1 \3</suggestion>".</message>
                <example></example>
            </rule>
        </rulegroup>

        <rulegroup id="jo" name="Jo">
            <rule id="komats_jo_jo" name="Komats pirms vairākiem jo palīgteikumiem">
                <pattern>
                    <marker>
                        <token negate="yes">,</token>
                        <token spacebefore="yes">jo</token>
                    </marker>
                    <token postag="a.*c|rc.*|vm.p.*c." postag_regexp="yes"/>
                    <token max="-1"/>
                    <token spacebefore="yes">jo</token>
                    <token postag="a.*c|rc.*|vm.p.*c." postag_regexp="yes"/>
                </pattern>
                <message>Šajā teikumā pirms vārda "jo" visticamāk ir jālieto komats - "<suggestion>\1, \2</suggestion>".</message>
                <example correction=", jo"><marker> jo</marker></example>
            </rule>
            <rule id="komats_jo" name="Komats pirms jo">
                <antipattern>
                    <token postag="[a|r].*" postag_regexp="yes"/>
                    <marker><token spacebefore="yes">jo</token></marker>
                    <token><match no="0"/></token>
                </antipattern>
                <antipattern>
                    <!--                TODO: Bet tomēr liek, ja tālāk seko vēl viens jo palīgteikums-->
                    <token inflected="yes" regexp="yes">būt|vēl|taču|tad|kas|tādēļ|tāpēc|toties</token>
                    <marker><token spacebefore="yes">jo</token></marker>
                    <token postag="a.*c|rc.*|vm.p.*c." postag_regexp="yes"/>
                </antipattern>
                <antipattern>
                    <token regexp="yes">un|bet</token>
                    <marker><token spacebefore="yes">jo</token></marker>
                    <token regexp="yes">sevišķi|īpaši</token>
                </antipattern>
                <pattern>
                    <token regexp="yes" negate="yes">\p{Punct}</token>
                    <token spacebefore="yes">jo</token>
                </pattern>
                <message>Šajā teikumā pirms vārda "jo" visticamāk ir jālieto komats - "<suggestion>\1, \2</suggestion>".</message>
                <example correction=", jo"><marker> jo</marker></example>
            </rule>
            <rule id="x_jo_x" name="Nav komats pirms x jo x">
                <pattern>
                    <token postag="[a|r].*" postag_regexp="yes"/>
                    <marker>
                        <token>,</token>
                        <token spacebefore="yes">jo</token>
                    </marker>
                    <token><match no="0"/></token>
                </pattern>
                <message>Šajā teikumā pirms "x jo x" visticamāk nav jālieto komats - "<suggestion> \3</suggestion>".</message>
                <example></example>
            </rule>
            <rule id="jo_kkam" name="Nav komats pirms jo kkam">
                <antipattern>
                    <marker>
                        <token>,</token>
                        <token spacebefore="yes">jo</token>
                    </marker>
                    <token postag="a.*c|rc.*|vm.p.*c." postag_regexp="yes"/>
                    <token max="-1"/>
                    <token spacebefore="yes">jo</token>
                    <token postag="a.*c|rc.*|vm.p.*c." postag_regexp="yes"/>
                </antipattern>
                <pattern>
                    <token inflected="yes" regexp="yes">būt|vēl|taču|tad|kas|tādēļ|tāpēc|toties</token>
                    <marker>
                        <token>,</token>
                        <token spacebefore="yes">jo</token>
                    </marker>
                    <token postag="a.*c|rc.*|vm.p.*c." postag_regexp="yes"/>
                </pattern>
                <message>Šajā teikumā pirms "jo x" visticamāk nav jālieto komats - "<suggestion> \3</suggestion>".</message>
                <example></example>
            </rule>
            <rule id="jo_īpaši" name="Nav komats pirms jo īpaši">
                <pattern>
                    <token regexp="yes">un|bet</token>
                    <marker>
                        <token>,</token>
                        <token spacebefore="yes">jo</token></marker>
                    <token regexp="yes">sevišķi|īpaši</token>
                </pattern>
                <message>Šajā teikumā pirms "jo īpaši" visticamāk nav jālieto komats - "<suggestion> \3</suggestion>".</message>
                <example></example>
            </rule>
        </rulegroup>

