<!--    ŠEIT SĀKAS TEHNISKĀ NOFORMĒJUMA KĻŪDU ANALĪZE -->

    <category id="TEHN" name="Tehniskais noformējums" type="formatting">
        <rulegroup id="viens_burts_savienojums" name="Vārdi, kas sevī satur alfabēta burtu sākumā">
            <rule id="viens_burts_defise" name="Defises lietojums pēc alfabēta burta">
                <pattern>
                    <token regexp="yes">(\p{Lu})[-–—](\p{Ll}+)</token>
                </pattern>
                <message>Defisi nelieto starp kādu alfabēta burtu un tam sekojošo vārdu. <suggestion><match no="1" regexp_match="(\p{Lu})-(\p{Ll}+)" regexp_replace="$1 $2"/></suggestion></message>
                <example correction=" ">Es iedzēru tableti ar <marker>C vitamīnu</marker>.</example>
            </rule>
            <rule id="viens_burts_domuzime" name="Domuzīmes lietojums pēc alfabēta burta">
                <pattern>
                    <token regexp="yes">\p{Lu}</token>
                    <token regexp="yes" spacebefore="no">[-–—]</token>
                    <token spacebefore="no" regexp="yes">\p{Ll}+</token>
                </pattern>
                <message>Domuzīmi nelieto starp kādu alfabēta burtu un tam sekojošo vārdu. <suggestion>\1 \3</suggestion></message>
                <example correction=" ">Es iedzēru tableti ar <marker>C vitamīnu</marker>.</example>
            </rule>
        </rulegroup>
        <rulegroup id="simbolu_grupa" name="Defises lietojums starp ciparu vai simbolu grupām">
            <rule id="ciparu_simbolu_grupa" name="Defises lietojums starp ciparu vai simbolu grupām">
<!--            TODO: Pievienot likumus patvaļīgai secībai un skaitam daļu   -->
                <pattern>
                    <token regexp="yes">\p{Lu}+</token>
                    <token regexp="yes" spacebefore="no">[-–—]</token>
                    <token spacebefore="no" regexp="yes">\d+</token>
                </pattern>
                <message>Starp ciparu vai simbolu grupām tipiski pielieto defisi, vēlams <suggestion>\1-\3</suggestion></message>
                <example correction="LV-1002">Adreses pasta kods ir <marker>LV–1002</marker>.</example>
            </rule>
            <rule id="laika_grupa" name="Domuzīmes lietojums starp ciparu grupām">
                <!--            TODO: Pievienot likumus patvaļīgai secībai un skaitam daļu   -->
                <pattern>
                    <token regexp="yes">(\d{2}\.\d{2})[-–—](\d{2}\.\d{2})</token>
                </pattern>
                <message>Starp ciparu vai simbolu grupām tipiski pielieto defisi, vēlams <suggestion>\1-\2</suggestion></message>
                <example correction="LV-1002">Adreses pasta kods ir <marker>LV–1002</marker>.</example>
            </rule>
        </rulegroup>

