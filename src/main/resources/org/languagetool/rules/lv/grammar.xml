<!--    ŠEIT SĀKAS PAREIZRAKSTĪBAS KĻŪDU ANALĪZE -->

    <category id="PARE" name="Pareizrakstība" type="grammar">
        <rule id="EXAMPLE_RULE1" name="My example rule">
            <pattern>
                <token>foo</token>
                <token>bar</token>
            </pattern>
            <message>Did you mean <suggestion>bicycle</suggestion>?</message>
            <example correction="bicycle">My <marker>foo bar</marker> is broken.</example>
            <example>My car is broken.</example>
        </rule>
    </category>



